# ════════════════════════════════════════════════════════════
#  SAW MÓVEIS — .htaccess
#  Apache configuration: SEO, segurança e performance
# ════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────
#  BLOQUEAR QUERY STRINGS SPAM (SEO poisoning)
#  Retorna 410 Gone para URLs com termos suspeitos
#  (Google interpreta 410 como "essa URL não existe e nunca mais vai existir"
#   e remove do índice mais rápido que 404)
# ──────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloqueia query strings com termos adultos/spam
  RewriteCond %{QUERY_STRING} (xnxx|xvideos|porn|sex|viagra|cialis|casino|poker|gambling) [NC,OR]
  # Bloqueia query strings com strings hex random típicas de bot scanner
  RewriteCond %{QUERY_STRING} ^[a-z0-9]{15,}/ [NC,OR]
  # Bloqueia query strings sem nome de parâmetro reconhecido (formato spam)
  RewriteCond %{QUERY_STRING} ^[^=&]+/[^=&]+/[^=&]+ [NC]
  RewriteRule ^.*$ - [G,L]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Force www (canonical: https://www.sawmoveis.com.br)
  RewriteCond %{HTTP_HOST} ^sawmoveis\.com\.br [NC]
  RewriteRule ^(.*)$ https://www.sawmoveis.com.br/$1 [R=301,L]
</IfModule>

# ──────────────────────────────────────────────────────
#  HEADERS DE SEGURANÇA
# ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Previne clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Previne MIME sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Referrer policy (não vaza URL completa pra outros sites)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Permissions Policy (desabilita features sensíveis não usadas)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS (força HTTPS por 1 ano)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Remove header Server (segurança por obscuridade)
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# ──────────────────────────────────────────────────────
#  CACHE DE ASSETS (performance + SEO PageSpeed)
# ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML: cache curto (pode mudar)
  ExpiresByType text/html "access plus 1 hour"

  # CSS / JS: 1 mês
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Imagens: 6 meses
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/gif "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"

  # Fontes: 1 ano
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ──────────────────────────────────────────────────────
#  COMPRESSÃO GZIP (reduz tamanho de download)
# ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ──────────────────────────────────────────────────────
#  PROTEGE ARQUIVOS SENSÍVEIS
# ──────────────────────────────────────────────────────
<FilesMatch "^\.(htaccess|htpasswd|env|git|ds_store)">
  Require all denied
</FilesMatch>

# Bloqueia acesso a arquivos de backup
<FilesMatch "\.(bak|backup|old|swp|tmp)$">
  Require all denied
</FilesMatch>

# ──────────────────────────────────────────────────────
#  PÁGINA 404 CUSTOMIZADA (opcional - pode redirecionar pra home)
# ──────────────────────────────────────────────────────
ErrorDocument 404 /

# ──────────────────────────────────────────────────────
#  REMOVE EXTENSÕES .html DA URL
#  /obrigado.html → /obrigado
# ──────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
